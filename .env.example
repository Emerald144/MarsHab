# TerraNexis local configuration example. Copy to .env (git-ignored) or set in your shell.
# No secrets are required by this project.

# Backend (FastAPI): root of the data/ tree. Absolute path, or relative to the repository root.
# Default when unset: <repo>/data
# TERRANEXIS_DATA_ROOT=data

# Backend CORS: comma-separated exact frontend origins; replaces local defaults.
# Unset defaults to localhost/127.0.0.1 on ports 5173 and 8080.
# Set to an empty string to disable cross-origin access. Wildcards are rejected.
# TERRANEXIS_CORS_ORIGINS=https://your-frontend.example
